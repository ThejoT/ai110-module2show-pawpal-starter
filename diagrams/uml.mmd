classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +get_all_tasks() list~Task~
        +to_dict() dict
        +from_dict(data)$ Owner
        +save_to_json(path) None
        +load_from_json(path)$ Owner
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +get_tasks() list~Task~
        +task_count() int
    }

    class Task {
        +str description
        +str time
        +str frequency
        +date due_date
        +bool completed
        +str priority
        +int duration_minutes
        +str pet_name
        +mark_complete() Task
    }

    class Scheduler {
        +Owner owner
        +get_todays_schedule(day) list~Task~
        +sort_by_time(tasks)$ list~Task~
        +sort_by_priority(tasks)$ list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +mark_task_complete(task) Task
        +detect_conflicts(tasks) list~str~
        +find_next_available_slot(duration_minutes, day, day_start, day_end) str
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : reads tasks via get_all_tasks()
    Task ..> Task : mark_complete() creates next occurrence
